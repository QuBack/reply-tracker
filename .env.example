# Copy to .env for Docker Compose. Keep the real .env outside Git.
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(48))"
CODEX_GATEWAY_TOKEN=replace-with-a-random-token-of-at-least-32-characters
WEB_ALLOW_REGISTRATION=0
WEB_TRUSTED_HOSTS=localhost,127.0.0.1
# Set to 1 after configuring HTTPS on your public domain.
WEB_SECURE_COOKIES=0
# The exact trusted reverse proxy IP, when applicable; never use a wildcard.
WEB_TRUSTED_PROXY=
